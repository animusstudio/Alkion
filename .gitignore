# --- Secrets / env ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# --- Logs ---
*.log
logs/

# --- Common build / dep dirs (language-agnostic, kept here pre-stack-decision) ---
node_modules/
dist/
build/
out/
.next/
.svelte-kit/
.turbo/
.cache/
coverage/

# Python (scripts/, tests/)
__pycache__/

# --- Local data ---
*.sqlite
*.sqlite-journal
*.db
data/
# Flutter source directories named 'data' are NOT local data files
!app/lib/data/
!app/test/data/

# --- Flutter / Dart (app/) ---
app/.dart_tool/
app/.fvm/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/*.iml
# Explicit private development catalog projection and its admission manifest.
app/assets/catalog_trial/*.dev.json
# NOTE: app/build/ is already covered by the generic build/ rule above.
# NOTE: app/pubspec.lock is intentionally NOT ignored — committed for reproducible builds.
# NOTE: profile SQLite files live outside the repo; *.db/*.sqlite already covered.
