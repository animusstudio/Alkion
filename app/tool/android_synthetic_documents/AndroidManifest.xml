<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.animusstudio.alkion.synthetic.documents"
    android:versionCode="1" android:versionName="synthetic">
    <application android:label="Alkion Synthetic Documents" android:allowBackup="false"
        android:debuggable="true" android:usesCleartextTraffic="false">
        <!-- Setup/receipts are owner-only files via the guarded harness, never IPC. -->
        <provider android:name=".SyntheticDocumentsProvider"
            android:authorities="dev.animusstudio.alkion.synthetic.documents.provider"
            android:enabled="false"
            android:exported="true" android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER"/>
            </intent-filter>
        </provider>
    </application>
</manifest>
