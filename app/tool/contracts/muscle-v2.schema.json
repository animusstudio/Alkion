          "then": {
            "properties": {
              "reviewer_id": {
                "$ref": "#/$defs/v1_id"
              },
              "reviewed_on": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
