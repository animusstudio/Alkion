{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alkion:muscle-assessment:schema:2",
  "$ref": "#/$defs/bundle",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "format": "date-time"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "kind": {
      "enum": [
        "strength",
        "stretch_target",
        "mobility_target",
        "conditioning_participation"
      ]
    },
    "role": {
      "anyOf": [
        {
          "enum": [
            "primary",
            "secondary",
            "stabilizer"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "access": {
      "enum": [
        "accessible",
        "blocked",
        "missing",
        "error"
      ]
    },
    "profile_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "id",
        "revision",
        "sha256"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "agent",
            "human"
          ]
        },
        "name": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "kind",
        "name"
      ]
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "equipment": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "grip": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "support": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "angle": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "resistance_direction": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "laterality": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_phase": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "equipment",
        "grip",
        "support",
        "angle",
        "resistance_direction",
        "laterality",
        "execution_phase"
      ]
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "query": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "anyOf": [
            {
              "$ref": "#/$defs/url"
            },
            {
              "type": "null"
            }
          ]
        },
        "access_result": {
          "$ref": "#/$defs/access"
        },
        "outcome": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "query",
        "url",
        "access_result",
        "outcome"
      ]
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "$ref": "#/$defs/text"
        },
        "next_evidence_needed": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "reason",
        "next_evidence_needed"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "publisher_id": {
          "$ref": "#/$defs/id"
        },
        "publication_status": {
          "enum": [
            "current",
            "retracted",
            "withdrawn",
            "unverified"
          ]
        },
        "source_kind": {
          "enum": [
            "official_reference",
            "research_publication",
            "anatomy_reference",
            "equipment_manual"
          ]
        }
      },
      "required": [
        "id",
        "url",
        "title",
        "publisher_id",
        "publication_status",
        "source_kind"
      ]
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "anatomy_node_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "action": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "anatomy_node_id",
        "kind",
        "role",
        "action"
      ]
    },
    "variant_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "variant_id": {
          "$ref": "#/$defs/uuid"
        },
        "variant_revision": {
          "$ref": "#/$defs/revision"
        },
        "execution_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "variant_id",
        "variant_revision",
        "execution_sha256"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "anatomy_revision": {
          "$ref": "#/$defs/id"
        },
        "declared_on": {
          "$ref": "#/$defs/timestamp"
        },
        "declared_by": {
          "$ref": "#/$defs/id"
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "applicable_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          },
          "minItems": 1
        },
        "exclusions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 0
        },
        "execution_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant_binding"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "revision",
        "anatomy_revision",
        "declared_on",
        "declared_by",
        "rationale",
        "applicable_actions",
        "cells",
        "exclusions",
        "execution_bindings"
      ]
    },
    "scope_registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "alkion-muscle-scope-registry"
        },
        "schema_version": {
          "const": 2
        },
        "revision": {
          "$ref": "#/$defs/id"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scope"
          },
          "minItems": 0
        }
      },
      "required": [
        "format",
        "schema_version",
        "revision",
        "scopes"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "source_id": {
          "$ref": "#/$defs/id"
        },
        "url": {
          "$ref": "#/$defs/url"
        },
        "locator": {
          "$ref": "#/$defs/text"
        },
        "accessed_on": {
          "$ref": "#/$defs/date"
        },
        "access_result": {
          "$ref": "#/$defs/access"
        },
        "support_status": {
          "enum": [
            "supports",
            "contradicts",
            "rejected",
            "unverified"
          ]
        },
        "claim_kind": {
          "enum": [
            "execution_relationship",
            "execution_mechanics",
            "anatomy_action",
            "scope_exclusion"
          ]
        },
        "variant_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "variant_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "anatomy_node_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/kind"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "action": {
          "$ref": "#/$defs/text"
        },
        "establishes": {
          "$ref": "#/$defs/text"
        },
        "setup_comparison": {
          "$ref": "#/$defs/text"
        },
        "exact_setup_match": {
          "type": "boolean"
        },
        "granularity": {
          "enum": [
            "group",
            "muscle",
            "muscle_region",
            "movement_only"
          ]
        }
      },
      "required": [
        "id",
        "source_id",
        "url",
        "locator",
        "accessed_on",
        "access_result",
        "support_status",
        "claim_kind",
        "variant_id",
        "variant_revision",
        "execution_sha256",
        "anatomy_node_id",
        "kind",
        "role",
        "action",
        "establishes",
        "setup_comparison",
        "exact_setup_match",
        "granularity"
      ]
    },
    "confidence_criteria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 0
        },
        "independent_source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1
        },
        "exact_execution_supported": {
          "type": "boolean"
        },
        "material_conflict": {
          "type": "boolean"
        }
      },
      "required": [
        "rationale",
        "limitations",
        "independent_source_ids",
        "exact_execution_supported",
        "material_conflict"
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "cell_id": {
          "$ref": "#/$defs/id"
        },
        "anatomy_node_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "phase": {
          "$ref": "#/$defs/text"
        },
        "confidence": {
          "enum": [
            "unassessed",
            "low",
            "moderate",
            "high"
          ]
        },
        "confidence_criteria": {
          "$ref": "#/$defs/confidence_criteria"
        },
        "evidence_basis": {
          "enum": [
            "direct",
            "biomechanical_inference"
          ]
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "setup_comparison": {
          "$ref": "#/$defs/text"
        },
        "reasoning_chain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "cell_id",
        "anatomy_node_id",
        "kind",
        "role",
        "phase",
        "confidence",
        "confidence_criteria",
        "evidence_basis",
        "claim_ids",
        "rationale",
        "setup_comparison",
        "reasoning_chain"
      ]
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pending",
            "reviewed"
          ]
        },
        "reviewer_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewed_on": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "attestation_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "status",
        "reviewer_id",
        "reviewed_on",
        "attestation_id",
        "rationale"
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "variant_id": {
          "$ref": "#/$defs/uuid"
        },
        "variant_revision": {
          "$ref": "#/$defs/revision"
        },
        "execution_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "scope_ref": {
          "$ref": "#/$defs/profile_ref"
        },
        "assessment_id": {
          "$ref": "#/$defs/id"
        },
        "coverage": {
          "enum": [
            "unknown",
            "partial",
            "complete"
          ]
        },
        "side_scope": {
          "enum": [
            "unspecified",
            "bilateral",
            "left",
            "right"
          ]
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          },
          "minItems": 0
        },
        "coverage_note": {
          "$ref": "#/$defs/text"
        },
        "human_review": {
          "$ref": "#/$defs/human_review"
        },
        "previous_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/profile_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "change_rationale": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "revision",
        "variant_id",
        "variant_revision",
        "execution_sha256",
        "scope_ref",
        "assessment_id",
        "coverage",
        "side_scope",
        "relationships",
        "coverage_note",
        "human_review",
        "previous_profile",
        "change_rationale"
      ]
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "supported",
            "excluded",
            "unresolved"
          ]
        },
        "relationship_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "next_evidence_needed": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "cell_id",
        "status",
        "relationship_ids",
        "claim_ids",
        "rationale",
        "next_evidence_needed"
      ]
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pending",
            "accepted",
            "changes_requested"
          ]
        },
        "reviewed_on": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "type": "null"
            }
          ]
        },
        "rationale": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "status",
        "reviewed_on",
        "rationale"
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "variant_id": {
          "$ref": "#/$defs/uuid"
        },
        "variant_revision": {
          "$ref": "#/$defs/revision"
        },
        "execution_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile_id": {
          "$ref": "#/$defs/id"
        },
        "profile_revision": {
          "$ref": "#/$defs/revision"
        },
        "profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "catalog_revision": {
          "$ref": "#/$defs/id"
        },
        "execution_catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "anatomy_revision": {
          "$ref": "#/$defs/id"
        },
        "scope_ref": {
          "$ref": "#/$defs/profile_ref"
        },
        "assessment_status": {
          "enum": [
            "pending",
            "assessed"
          ]
        },
        "researcher_id": {
          "$ref": "#/$defs/id"
        },
        "reconciler_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "reconciliation": {
          "$ref": "#/$defs/reconciliation"
        },
        "searched_on": {
          "anyOf": [
            {
              "$ref": "#/$defs/date"
            },
            {
              "$ref": "#/$defs/timestamp"
            }
          ]
        },
        "setup": {
          "$ref": "#/$defs/setup"
        },
        "search_log": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/search"
          },
          "minItems": 1
        },
        "dispositions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/disposition"
          },
          "minItems": 0
        },
        "closure_rationale": {
          "anyOf": [
            {
              "$ref": "#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "unresolved": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          },
          "minItems": 0
        },
        "contradictions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 0
        },
        "omitted_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "variant_id",
        "variant_revision",
        "execution_sha256",
        "profile_id",
        "profile_revision",
        "profile_sha256",
        "catalog_revision",
        "execution_catalog_sha256",
        "anatomy_revision",
        "scope_ref",
        "assessment_status",
        "researcher_id",
        "reconciler_id",
        "reconciliation",
        "searched_on",
        "setup",
        "search_log",
        "dispositions",
        "closure_rationale",
        "unresolved",
        "contradictions",
        "omitted_claims"
      ]
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "enum": [
            1,
            2
          ]
        },
        "profile_id": {
          "$ref": "#/$defs/id"
        },
        "profile_revision": {
          "$ref": "#/$defs/revision"
        },
        "profile_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "payload": {
          "type": "object"
        },
        "source_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "schema_version",
        "profile_id",
        "profile_revision",
        "profile_sha256",
        "payload",
        "source_artifact_sha256",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/v1_muscle_profile"
              }
            }
          },
          "else": {
