        "variant_id",
        "variant_revision",
        "revision",
        "coverage",
        "side_scope",
        "relationships",
        "coverage_note",
        "review",
        "coverage_scope"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "relationships": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "coverage": {
                "enum": [
                  "partial",
                  "complete"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "relationships": {
                "minItems": 1
              }
            }
          }
        }
